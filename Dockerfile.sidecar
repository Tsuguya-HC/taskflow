# Build the sidecar binary. Same shape as the manager's Dockerfile; the two
# binaries share a module and a base image, and differ only in the entrypoint.
FROM golang:1.27@sha256:4013ae0f9e7994f8535c58c811f8f863fbed38b72e0d51e6592156f758d66146 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o sidecar cmd/sidecar/main.go

# nonroot is uid 65532, this image's USER — one candidate among the uids the
# injected containers can run as, not a number the handler's author has to
# avoid. The controller picks the actual uid per Job, stepping down from here
# past every uid the handler's template already names (docs/design.md §7).
FROM gcr.io/distroless/static:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7
WORKDIR /
COPY --from=builder /workspace/sidecar .
USER 65532:65532

ENTRYPOINT ["/sidecar"]
