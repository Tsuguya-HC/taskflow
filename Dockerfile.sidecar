# Build the sidecar binary. Same shape as the manager's Dockerfile; the two
# binaries share a module and a base image, and differ only in the entrypoint.
FROM golang:1.27@sha256:65b6f280bf050ec5af12716857e8ea8439d694dbba8f31ceeb7630670071f2bb AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o sidecar cmd/sidecar/main.go

# nonroot is uid 65532 — the user that owns out/ and closes it. The agent must
# run as some other uid (the design's example uses 65533) for the closing to
# mean anything.
FROM gcr.io/distroless/static:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7
WORKDIR /
COPY --from=builder /workspace/sidecar .
USER 65532:65532

ENTRYPOINT ["/sidecar"]
